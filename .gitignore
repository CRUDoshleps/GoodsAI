# Local datasets: never commit original or processed data.
/data/
.local_inventory.json
**/context/datasets/

# Local experiment artifacts, predictions, models and logs.
/outputs/
/logs/
/mlruns/
/wandb/
/models/

# Internal output publication state (never delete locks while a writer runs).
.*.goodsai.lock
.*.goodsai-transaction.json
.*.goodsai-*.tmp
.goodsai-txn-*/

# Secrets (examples must contain placeholders only).
.env
.env.*
!.env.example
ai.env
*.pem
*.key
/secrets/

# Python environments and caches.
.venv/
.venv-ml/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.log

# Local Python package installation and build artifacts.
*.egg-info/
/build/
/dist/

# OS metadata and editor recovery files (never source or delivery artifacts).
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
~$*
