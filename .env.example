# LLM fallback (LLM-003). Copy to .env locally; never commit real values.
# Policy llm-data-policy-2026-10-19: organizer gateway only, HTTPS, no credentials in the URL.
GOODSAI_LLM_BASE_URL=https://<gateway-host>/v1
GOODSAI_LLM_API_KEY=<key>
GOODSAI_LLM_MODEL=<model-name>
# Only API uses this opt-in; CLI still requires --llm. No automatic .env loading.
GOODSAI_LLM_ENABLED=0
# Profile < recognized env < explicit CLI flags. Values below override the profile.
GOODSAI_LLM_MAX_CALLS=100
GOODSAI_LLM_DAILY_MAX_CALLS=300
GOODSAI_LLM_BUDGET_FILE=outputs/llm-budget/ledger.json
GOODSAI_LLM_TIMEOUT=60
GOODSAI_LLM_ATTEMPTS=3
GOODSAI_LLM_MAX_TOKENS=2048
GOODSAI_LLM_CONCURRENCY=2
GOODSAI_LLM_CIRCUIT_BREAKER=5
GOODSAI_LLM_JSON_MODE=0
# Optional; leave unset for no cache and unknown price (N/A), respectively.
# GOODSAI_LLM_CACHE_DIR=outputs/llm-cache
# GOODSAI_LLM_PRICE_INPUT_PER_1K=<price per 1000 prompt tokens>
# GOODSAI_LLM_PRICE_OUTPUT_PER_1K=<price per 1000 completion tokens>
GOODSAI_LLM_REQUEST_DEADLINE=120
